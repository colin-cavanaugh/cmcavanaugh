{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler", // <-- important for Vite-style imports
    "types": ["vite/client"], // <-- lets TS accept asset imports
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "src/components/**/*",
    "src/types/**/*.d.ts" // <-- include the asset declarations
  ],
  "exclude": ["node_modules", "dist", "test", "src/leetcode"]
}
